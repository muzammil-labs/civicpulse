# Copy to .env.local and fill in. Never commit real keys.

# ── Supabase (Project settings → API) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security: used for usage metering and the demo setup script.
SUPABASE_SERVICE_ROLE_KEY=

# ── Demo society ──────────────────────────────────────────────
# Password shared by the three demo accounts (created by `npm run demo:setup`). Use a long random value.
DEMO_USER_PASSWORD=

# ── AI (Google AI Studio → API key) ───────────────────────────
GEMINI_API_KEY=
# true = never call the AI; use free keyword rules instead (good for demos and tests)
MOCK_AI=false

# ── Branding ──────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=Sahvaas
NEXT_PUBLIC_SUPPORT_EMAIL=hello@example.com
